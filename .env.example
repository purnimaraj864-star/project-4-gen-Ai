# --- Required: LLM access (any OpenAI-compatible endpoint) -------------------
# OpenAI:        https://platform.openai.com/api-keys
# Groq (free):   https://console.groq.com/keys  -> set OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                and LLM_MODEL=llama-3.1-8b-instant (or another Groq model)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI itself; set for OpenAI-compatible providers (e.g. Groq).
OPENAI_BASE_URL=

# --- Knowledge base -----------------------------------------------------------
# PDF_PATH=data/History_2024-25.pdf
# CHROMA_DIR=chroma_db
# COLLECTION_NAME=obsw_history_catalogue
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Tuning -------------------------------------------------------------------
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=6
# RETRIEVAL_SCORE_THRESHOLD=1.2
# EVIDENCE_OVERLAP_THRESHOLD=0.35
